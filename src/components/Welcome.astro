---
import Selector from "./Selector";

const currentPath = Astro.url.pathname === "/" 
  ? "/" 
  : Astro.url.pathname.replace(/\/$/, '');

const menuItems = [
  { path: '/', label: 'Tablas' },
  { path: '/dates', label: 'Fechas' },
  { path: '/teams', label: 'Equipos' },
  { path: '/rules', label: 'Reglas' }
];
---

<header>
  <div class="flex flex-col items-center justify-center gap-4 py-6">
    <img
      src="/logo.png"
      alt="Sport Tabaco & Ron Palao"
      class="mx-auto w-30 sm:w-36 h-auto object-contain"
    />

    <Selector client:load />

    <ul class="bg-dark-light border border-gold/20 w-full flex items-center justify-center text-sm text-gray font-semibold rounded-lg overflow-hidden">
      {menuItems.map((item, index) => {
        const isFirst = index === 0;
        const isLast = index === menuItems.length - 1;
        const isActive = currentPath === item.path;
        
        return (
          <li class={`
            text-center flex-1 transition-colors relative
            ${isActive ? 'bg-gold text-dark' : 'hover:bg-white/10 hover:text-white'}
            ${isActive && isFirst ? 'rounded-l-lg' : ''}
            ${isActive && isLast ? 'rounded-r-lg' : ''}
          `}>
            <a href={item.path} class="w-full h-full block px-4 py-3">
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>
